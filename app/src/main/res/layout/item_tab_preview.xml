<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="220dp"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:strokeColor="#E0E0E0"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivTabPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="#F5F5F5" />

        <!-- Selected Glow Overlay -->
        <View
            android:id="@+id/selectedGlow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#4D000000"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="#CC000000" />

        <ImageView
            android:id="@+id/incognitoIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="12dp"
            android:layout_centerVertical="false"
            android:layout_marginTop="10dp"
            android:src="@drawable/incognito"
            app:tint="@android:color/white"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvTabTitle"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:layout_toEndOf="@id/incognitoIcon"
            android:paddingStart="8dp"
            android:paddingEnd="48dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCloseTab"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ex"
            app:tint="@android:color/white" />

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>