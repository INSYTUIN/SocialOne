<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <RelativeLayout
        android:id="@+id/mainLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/contentWrapper"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeRefreshLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <FrameLayout
                    android:id="@+id/webViewContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <FrameLayout
                android:id="@+id/fragmentContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_alignParentTop="true"
            android:indeterminate="true"
            android:visibility="gone"
            android:elevation="10dp"
            android:progressTint="@color/button_background"
            android:indeterminateTint="@color/button_background" />

        <!-- Use a vertical LinearLayout for the bottom UI to fix squishing and visibility issues -->
        <LinearLayout
            android:id="@+id/bottomUiContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Drag Handle Area - Always at the top of the container -->
            <FrameLayout
                android:id="@+id/handleTouchArea"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:visibility="gone"
                android:clipChildren="false">

                <ImageView
                    android:id="@+id/dragHandle"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="right|bottom"
                    android:layout_marginEnd="22dp"

                    android:background="@drawable/bg_drag_handle"
                    android:contentDescription="@string/toggle_controls"
                    android:elevation="4dp"
                    android:padding="6dp"
                    android:src="@drawable/uparrow"
                    app:tint="@color/button_text" />
            </FrameLayout>

            <View
                android:id="@+id/hideModeSpacer"
                android:layout_width="match_parent"
                android:layout_height="0dp" />

            <!-- Tab Switcher Panel -->
            <androidx.cardview.widget.CardView
                android:id="@+id/tabSwitcherPanel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginHorizontal="@dimen/panel_margin"
                android:layout_marginBottom="2dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                tools:layout_height="500dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/panel_background"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tvTabSwitcherTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:text="@string/tab_switcher_title"
                            android:textColor="@color/button_background"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/tabModeSwitchContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_centerInParent="true"
                            android:background="@drawable/bg_tab_switch"
                            android:orientation="horizontal"
                            android:padding="2dp">

                            <ImageButton
                                android:id="@+id/btnNormalMode"
                                android:layout_width="48dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_tab_switch_selected"
                                android:contentDescription="Normal Mode"
                                android:padding="8dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/user"
                                app:tint="@color/button_text" />

                            <ImageButton
                                android:id="@+id/btnWorkspaceMode"
                                android:layout_width="48dp"
                                android:layout_height="36dp"
                                android:background="@android:color/transparent"
                                android:contentDescription="Workspace Mode"
                                android:padding="8dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/suitcase"
                                app:tint="@color/icon_tint" />

                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/btnIncognito"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="12dp"
                            android:layout_toStartOf="@id/btnDeleteAllTabs"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/incognito_mode"
                            android:scaleType="fitCenter"
                            android:src="@drawable/incognito"
                            app:tint="@color/icon_tint" />

                        <ImageButton
                            android:id="@+id/btnDeleteAllTabs"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/remove_button"
                            android:scaleType="fitCenter"
                            android:src="@drawable/trashbin"
                            app:tint="@color/icon_tint" />
                    </RelativeLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/tabSwitcherRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="12dp"
                        android:clipToPadding="false"
                        android:paddingHorizontal="8dp"
                        android:paddingBottom="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <FrameLayout
                android:id="@+id/panelsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Global Search Panel -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/searchPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/panel_margin"
                    android:visibility="gone"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/panel_background"
                        android:orientation="vertical"
                        android:padding="@dimen/panel_padding">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="@string/global_search_title"
                            android:textColor="@color/button_background"
                            android:textStyle="bold" />

                        <AutoCompleteTextView
                            android:id="@+id/searchInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:completionThreshold="1"
                            android:dropDownHeight="160dp"
                            android:hint="@string/search_hint"
                            android:imeOptions="actionSearch"
                            android:importantForAutofill="no"
                            android:inputType="text" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/select_sites_label"
                            android:textColor="@color/button_background"
                            android:textSize="12sp" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/searchSitesRecyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                        <Button
                            android:id="@+id/btnDoGlobalSearch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:backgroundTint="@color/button_background"
                            android:text="@string/search_compile_button"
                            android:textColor="@color/button_text"
                            app:cornerRadius="8dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/controlsPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/panel_margin"
                    android:visibility="gone"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="8dp"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/panel_background"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/panel_padding"
                        android:paddingTop="@dimen/panel_padding"
                        android:paddingEnd="0dp"
                        android:paddingBottom="@dimen/panel_padding">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <AutoCompleteTextView
                                android:id="@+id/urlInput"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:completionThreshold="1"
                                android:dropDownHeight="160dp"
                                android:hint="@string/add_website_hint"
                                android:imeOptions="actionDone"
                                android:importantForAutofill="no"
                                android:inputType="textUri" />

                            <ImageButton
                                android:id="@+id/btnNewTab"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginStart="8dp"
                                android:layout_marginEnd="6dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="New Tab"
                                android:padding="8dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/plus"
                                app:tint="@color/icon_tint" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/sitesRecyclerView"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                                tools:listitem="@layout/item_site" />

                            <FrameLayout
                                android:id="@+id/btnExpandTabs"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginEnd="6dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:clickable="true"
                                android:focusable="true">

                                <TextView
                                    android:id="@+id/tvTabCount"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_gravity="center"
                                    android:background="@drawable/bg_tab_count"
                                    android:gravity="center"
                                    android:text="2"
                                    android:textColor="@color/icon_tint"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </FrameLayout>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- More Options Panel -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/moreOptionsPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/panel_margin"
                    android:visibility="gone"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="8dp">

                    <androidx.core.widget.NestedScrollView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/panel_background"
                            android:orientation="vertical"
                            android:padding="@dimen/panel_padding">

                        <TextView
                            android:id="@+id/tvUserStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:gravity="center"
                            android:text="Logged in as Guest"
                            android:textColor="@color/secondary_text"
                            android:textSize="12sp"
                            android:textStyle="italic" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="@string/more_options"
                            android:textColor="@color/button_background"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnViewHistory"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginBottom="8dp"
                            android:backgroundTint="@color/button_background"
                            android:text="@string/view_history"
                            android:textColor="@color/button_text"
                            app:cornerRadius="8dp" />

                        <Button
                            android:id="@+id/btnViewDownloads"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginBottom="8dp"
                            android:backgroundTint="@color/button_background"
                            android:text="@string/view_downloads"
                            android:textColor="@color/button_text"
                            app:cornerRadius="8dp" />

                        <Button
                            android:id="@+id/btnFindOnPage"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginBottom="8dp"
                            android:backgroundTint="@color/button_background"
                            android:text="@string/find_on_page"
                            android:textColor="@color/button_text"
                            app:cornerRadius="8dp" />

                        <Button
                            android:id="@+id/btnShareQR"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginBottom="8dp"
                            android:backgroundTint="@color/button_background"
                            android:text="@string/share_qr"
                            android:textColor="@color/button_text"
                            app:cornerRadius="8dp" />

                        <Button
                            android:id="@+id/btnGrabMedia"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginBottom="8dp"
                            android:backgroundTint="@color/button_background"
                            android:text="Grab Media from Page"
                            android:textColor="@color/button_text"
                            app:cornerRadius="8dp" />

                        <Button
                            android:id="@+id/btnSettings"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginBottom="12dp"
                            android:backgroundTint="@color/button_background"
                            android:text="@string/settings_title"
                            android:textColor="@color/button_text"
                            app:cornerRadius="8dp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchDesktopSite"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="Desktop Site"
                            android:textColor="@color/primary_text"
                            app:thumbTint="@color/switch_thumb_tint"
                            app:trackTint="@color/switch_track_tint" />

                        <Button
                            android:id="@+id/btnAuthAction"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:backgroundTint="#FF5252"
                            android:text="Logout"
                            android:textColor="@android:color/white"
                            app:cornerRadius="8dp" />
                    </LinearLayout>
                    </androidx.core.widget.NestedScrollView>
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/bottomBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnCreatePost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/pen"
                    app:backgroundTint="@color/button_background"
                    app:fabSize="normal"
                    app:elevation="0dp"
                    app:pressedTranslationZ="0dp"
                    app:tint="@color/button_text"
                    android:contentDescription="Create Post" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/globalSearchButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:contentDescription="Global Search"
                    android:src="@drawable/websearch"
                    app:backgroundTint="@color/button_background"
                    app:fabSize="mini"
                    app:elevation="0dp"
                    app:pressedTranslationZ="0dp"
                    app:tint="@color/button_text" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/toggleControlsButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/toggle_controls"
                    android:src="@drawable/search"
                    app:backgroundTint="@color/button_background"
                    app:fabSize="mini"
                    app:elevation="0dp"
                    app:pressedTranslationZ="0dp"
                    app:tint="@color/button_text" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnForward"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="Forward"
                    android:src="@drawable/forward"
                    app:backgroundTint="@color/button_background"
                    app:fabSize="mini"
                    app:elevation="0dp"
                    app:pressedTranslationZ="0dp"
                    app:tint="@color/button_text" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/moreOptionsButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/more_options"
                    android:src="@drawable/threedots"
                    app:backgroundTint="@color/button_background"
                    app:fabSize="mini"
                    app:elevation="0dp"
                    app:pressedTranslationZ="0dp"
                    app:tint="@color/button_text" />

            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone" />

</RelativeLayout>
